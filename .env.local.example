# ─── DeepSeek (OpenAI-compatible) ────────────────────────────
# Get this from https://platform.deepseek.com/
# Used as the OpenAI client apiKey with baseURL https://api.deepseek.com
DEEPSEEK_API_KEY=sk-...

# ─── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ─────────────────────────────────────────────────────
# Used to verify requests come from your own frontend (any random string)
INTERNAL_API_SECRET=some-random-secret-string-change-me
