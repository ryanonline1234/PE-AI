# ─── Anthropic ───────────────────────────────────────────────
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ────────────────────────────────────────────────
# Project → Settings → API. The service-role key is server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ─────────────────────────────────────────────────────
# Shared secret between our own frontend and our API routes. Both values must
# be identical. This ships in the browser bundle, so it is obscurity only; the
# rate limiter is the real abuse control.
INTERNAL_API_SECRET=some-random-secret-string-change-me
NEXT_PUBLIC_INTERNAL_API_SECRET=some-random-secret-string-change-me

# Vercel Cron sends this as `Authorization: Bearer …` to /api/keepalive.
CRON_SECRET=another-random-string
